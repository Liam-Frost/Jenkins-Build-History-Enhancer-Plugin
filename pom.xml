<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2250.va_d01d559a_209</version>
    <relativePath />
  </parent>

  <groupId>io.jenkins.plugins</groupId>
  <artifactId>build-history-enhancer</artifactId>
  <version>${changelist}</version>
  <packaging>hpi</packaging>

  <name>Build History Enhancer</name>
  <description>Adds who-started-it metadata, an "only my builds" filter, server-side search and a
    reuse-parameters shortcut to the native Jenkins build history sidebar.</description>
  <url>https://github.com/${gitHubRepo}</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit/</url>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/${gitHubRepo}</connection>
    <developerConnection>scm:git:https://github.com/${gitHubRepo}</developerConnection>
    <tag>${scmTag}</tag>
    <url>https://github.com/${gitHubRepo}</url>
  </scm>

  <properties>
    <!-- Continuous delivery (JEP-229): the version is computed from the commit count and hash. -->
    <changelist>999999-SNAPSHOT</changelist>
    <!-- The repository this plugin will live in once hosted by the Jenkins project. -->
    <gitHubRepo>jenkinsci/${project.artifactId}-plugin</gitHubRepo>

    <!-- Minimum Jenkins version. The sidebar targets the build history card introduced in 2.5xx. -->
    <jenkins.baseline>2.580</jenkins.baseline>
    <jenkins.version>${jenkins.baseline}.2</jenkins.version>

    <spotless.check.skip>false</spotless.check.skip>

    <!-- Stricter checks than the parent's defaults, as recommended for new plugins. -->
    <hpi.strictBundledArtifacts>true</hpi.strictBundledArtifacts>
    <ban-deprecated-stapler.skip>false</ban-deprecated-stapler.skip>
    <ban-commons-lang-2.skip>false</ban-commons-lang-2.skip>
    <banObsoleteDependencyOverrides.skip>false</banObsoleteDependencyOverrides.skip>
    <ban-junit4-imports.skip>false</ban-junit4-imports.skip>

    <!-- Jenkins version whose builds-list API ReuseParametersEntryDecorator is compiled against. -->
    <bhe.newBuildsListApi.version>2.589</bhe.newBuildsListApi.version>
  </properties>

  <!--
    No plugin dependencies. Rebuilder is deliberately not one: RebuildLinkService reaches it by
    class name through the uber class loader, so the plugin works whether or not Rebuilder is
    installed.

    When adding the first plugin dependency, import the plugin BOM (io.jenkins.tools.bom:
    bom-${jenkins.baseline}.x) in a dependencyManagement section and leave the version out.
  -->
  <dependencies />

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>

  <!--
    ReuseParametersEntryDecorator extends jenkins.widgets.HistoryPageEntryDecorator, which is new in
    Jenkins 2.589, while the plugin keeps supporting older versions. Rather than raising the baseline,
    the two real class files are copied from jenkins-core 2.589 into target/classes so that javac can
    compile against the genuine API, and removed again before the tests and the package. The plugin
    therefore never ships a core class: Jenkins 2.589 and newer provide it, and older versions skip
    the decorator, which is an optional extension. See CONTRIBUTING.md.
  -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>new-builds-list-api</id>
            <goals>
              <goal>unpack</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.jenkins-ci.main</groupId>
                  <artifactId>jenkins-core</artifactId>
                  <version>${bhe.newBuildsListApi.version}</version>
                  <includes>jenkins/widgets/HistoryPageEntryDecorator*.class</includes>
                  <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                </artifactItem>
              </artifactItems>
              <overWriteReleases>true</overWriteReleases>
              <markersDirectory>${project.build.directory}/new-builds-list-api-markers</markersDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <executions>
          <execution>
            <id>remove-new-builds-list-api</id>
            <goals>
              <goal>clean</goal>
            </goals>
            <phase>process-test-classes</phase>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <directory>${project.build.outputDirectory}</directory>
                  <includes>
                    <include>jenkins/**</include>
                  </includes>
                </fileset>
                <fileset>
                  <directory>${project.build.directory}/new-builds-list-api-markers</directory>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
