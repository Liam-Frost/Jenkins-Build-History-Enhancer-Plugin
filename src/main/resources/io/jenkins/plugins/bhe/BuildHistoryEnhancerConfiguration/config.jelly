<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:section title="${%config.displayName}">
    <f:entry field="enabled" title="${%enabled.title}" description="${%enabled.description}">
      <f:checkbox default="true" />
    </f:entry>
    <f:entry field="pageSize" title="${%pageSize.title}" description="${%pageSize.description}">
      <f:number clazz="positive-number" default="30" min="5" max="100" step="1" />
    </f:entry>
    <f:entry field="maxScan" title="${%maxScan.title}" description="${%maxScan.description}">
      <f:number clazz="positive-number" default="2000" min="50" max="50000" step="50" />
    </f:entry>
  </f:section>
</j:jelly>
